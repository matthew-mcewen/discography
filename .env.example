# ===========================================================================
# Discography (multi-tenant) environment
# Copy to .env and fill in. Both the bot and the API read this file.
# ===========================================================================

# --- Shared -----------------------------------------------------------------
# The APPLICATION connection string. This role MUST be a non-superuser without
# BYPASSRLS, otherwise Postgres row-level security is skipped and tenants are
# no longer isolated. See DEPLOY.md.
DATABASE_URL=postgresql://discography_app:CHANGE_ME@localhost:5432/discography

# --- Bot (gateway process) --------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token
# Optional: also sync slash commands to this guild for instant dev propagation.
DEV_GUILD_ID=
# Scheduler cadence (minutes) and announce delay (hours after a period ends).
COUNT_INTERVAL_MINUTES=10
ANNOUNCE_INTERVAL_MINUTES=15
ANNOUNCE_DELAY_HOURS=7
# Seconds a cached per-guild config is trusted (NOTIFY invalidates sooner).
CONFIG_CACHE_TTL=60
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Management API process -------------------------------------------------
# Bootstrap admin key: accepted as a full-access key before any api_keys rows
# exist. Generate a long random value; rotate/remove once real keys are issued.
ADMIN_API_KEY=generate_a_long_random_string
# Comma-separated allowed browser origins for the dashboard (optional).
CORS_ORIGINS=
API_DB_POOL_MIN=1
API_DB_POOL_MAX=5

# --- Stripe (optional; billing) ---------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Map Stripe price ids to plan names: price_abc=pro,price_def=team
STRIPE_PRICE_PLANS=

# --- Postgres container (docker-compose only) -------------------------------
# Superuser used to run migrations and create the app role.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_superuser
POSTGRES_DB=discography
# Password for the non-superuser application role created on first boot.
APP_DB_PASSWORD=CHANGE_ME
# Superuser DSN used by the one-shot migrate service.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME_superuser@db:5432/discography
